# Generated macOS app bundles and per-machine runtime configuration.
dist/
boujoy-config.json
*.dSYM/

# Local runtimes, state, caches, and credentials never belong in the
# public source repository.
runtime/
.state/
.npm-cache/
.env
.env.*
!.env.example
*.pem
*.p12
*.mobileprovision
*.key
*.sqlite
*.sqlite3
*.db
*.jsonl

# The kernel workspace vault IS the knowledge base: it is versioned,
# not ignored. (The upstream template ignored vault/; this fork tracks it.)
# vault/

# Tooling and macOS noise.
__pycache__/
*.py[cod]
.pytest_cache/
coverage/
.DS_Store
__MACOSX/
*.log
